/*
 ==============================================================================
 |                  KIMBOS KILLJOY - FIXED OLED EDITION                      |
 ==============================================================================
*/

// --- DATA SEGMENT (This fixes your error) ---
// Each string is assigned an index starting from 0
data {
    "Kimbos";      // Index 0
    "KILLJOY";     // Index 1
    "RAPID FIRE";  // Index 2
    "ANTI RECOIL"; // Index 3
    "AIM ASSIST";  // Index 4
    "DROP SHOT";   // Index 5
    "MAIN MENU";   // Index 6
    "ON";          // Index 7
    "OFF";         // Index 8
}

// --- BUTTON LAYOUT ---
define FIRE_BTN   = XB1_RT;
define ADS_BTN    = XB1_LT;
define JUMP       = XB1_A;
define CROUCH     = XB1_B;
define LEFT       = XB1_LEFT;
define RIGHT      = XB1_RIGHT;
define MENU_BTN   = XB1_MENU;

// --- VARIABLES ---
int menu_active   = 0;
int menu_index    = 0;
int intro_timer   = 2000; 

// -- MOD TOGGLES --
int mod_rapidfire = 0; 
int mod_antirecoil= 0;
int mod_aimassist = 0;
int mod_dropshot  = 0;

define TOTAL_MODS = 4;

main {
    // --- INTRO SEQUENCE ---
    if (intro_timer > 0) {
        intro_timer = intro_timer - get_rtime();
        cls_oled(0);
        rect_oled(0, 0, 127, 63, 0, 1); 
        printf(30, 20, OLED_FONT_MEDIUM, 1, 0); // Calls "Kimbos"
        printf(25, 40, OLED_FONT_LARGE, 1, 1);  // Calls "KILLJOY"
    }
    else {
        // --- MENU TOGGLE (LT + MENU) ---
        if (get_val(ADS_BTN) && event_press(MENU_BTN)) {
            menu_active = !menu_active;
            if(!menu_active) cls_oled(0);
        }

        if (menu_active) {
            // Block Game Inputs
            set_val(FIRE_BTN, 0); set_val(ADS_BTN, 0); 
            set_val(JUMP, 0); set_val(CROUCH, 0); 

            // Navigation
            if (event_press(RIGHT)) {
                menu_index = (menu_index + 1) % TOTAL_MODS;
            }
            if (event_press(LEFT)) {
                menu_index = (menu_index + TOTAL_MODS - 1) % TOTAL_MODS;
            }

            // Toggle / Edit (A / Cross)
            if (event_press(JUMP)) {
                if (menu_index == 0) mod_rapidfire = !mod_rapidfire;
                if (menu_index == 1) mod_antirecoil = !mod_antirecoil;
                if (menu_index == 2) mod_aimassist = !mod_aimassist;
                if (menu_index == 3) mod_dropshot = !mod_dropshot;
            }

            // Dismiss (B / Circle)
            if (event_press(CROUCH)) {
                menu_active = 0;
                cls_oled(0);
            }

            DrawMenu();

        } else {
            // Gameplay Mods
            cls_oled(0); 
            if (mod_rapidfire && get_val(FIRE_BTN)) combo_run(cRapidFire);
            if (mod_aimassist && get_val(ADS_BTN))  combo_run(cAimAssist);
            if (mod_antirecoil && get_val(FIRE_BTN)) set_val(XB1_RY, get_val(XB1_RY) + 20);
        }
    }
}

function DrawMenu() {
    cls_oled(0);
    
    // Header
    rect_oled(0, 0, 128, 15, 1, 1);
    printf(35, 3, OLED_FONT_SMALL, 0, 6); // "MAIN MENU"

    // Arrows
    printf(5, 30, OLED_FONT_MEDIUM, 1, 0); // Using small helper or static text

    // Display Mod Name based on index
    // Note: Strings 2, 3, 4, 5 are the names
    printf(20, 25, OLED_FONT_MEDIUM, 1, menu_index + 2);

    // Status ON/OFF
    int status;
    if (menu_index == 0) status = mod_rapidfire;
    if (menu_index == 1) status = mod_antirecoil;
    if (menu_index == 2) status = mod_aimassist;
    if (menu_index == 3) status = mod_dropshot;

    if (status) printf(45, 48, OLED_FONT_LARGE, 1, 7); // "ON"
    else        printf(40, 48, OLED_FONT_LARGE, 1, 8); // "OFF"
}

combo cRapidFire {
    set_val(FIRE_BTN, 100);
    wait(40);
    set_val(FIRE_BTN, 0);
    wait(30);
}

combo cAimAssist {
    set_val(XB1_RX, 20);
    wait(20);
    set_val(XB1_RX, -20);
    wait(20);
}
