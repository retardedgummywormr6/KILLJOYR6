/*
 ==============================================================================
 |                  KIMBOS KILLJOY - 32-BIT COMPATIBLE                       |
 ==============================================================================
*/

// --- BUTTON DEFINITIONS ---
define FIRE_BTN   = 4;  
define ADS_BTN    = 7;  
define JUMP       = 19; 
define CROUCH     = 18; 
define LEFT       = 15; 
define RIGHT      = 16; 
define MENU_BTN   = 2;  

// --- VARIABLES ---
int menu_active   = 0;
int menu_index    = 0;
int intro_timer   = 2000; 

// -- MOD TOGGLES --
int mod_rapidfire = 0; 
int mod_antirecoil= 0;
int mod_aimassist = 0;
int mod_dropshot  = 0;

define TOTAL_MODS = 4;

main {
    // --- 1. INTRO SEQUENCE ---
    if (intro_timer > 0) {
        intro_timer = intro_timer - get_rtime();
        cls_oled(0);
        rect_oled(0, 0, 127, 63, 0, 1); 
        // Print "Kimbos Killjoy" (Index 0 in data)
        puts_oled(15, 25, 1, 0, 1); 
    }
    else {
        // --- 2. MENU TOGGLE LOGIC (LT + OPTIONS) ---
        if (get_val(ADS_BTN) && event_press(MENU_BTN)) {
            menu_active = !menu_active;
            if (!menu_active) cls_oled(0);
        }

        if (menu_active) {
            // Block game buttons
            set_val(FIRE_BTN, 0); set_val(ADS_BTN, 0); 
            set_val(JUMP, 0); set_val(CROUCH, 0);

            // Navigation
            if (event_press(RIGHT)) {
                menu_index = (menu_index + 1) % TOTAL_MODS;
            }
            if (event_press(LEFT)) {
                menu_index = (menu_index + TOTAL_MODS - 1) % TOTAL_MODS;
            }
            // Toggle (A / Cross)
            if (event_press(JUMP)) {
                if (menu_index == 0) mod_rapidfire = !mod_rapidfire;
                if (menu_index == 1) mod_antirecoil = !mod_antirecoil;
                if (menu_index == 2) mod_aimassist = !mod_aimassist;
                if (menu_index == 3) mod_dropshot = !mod_dropshot;
            }
            // Exit (B / Circle)
            if (event_press(CROUCH)) {
                menu_active = 0;
                cls_oled(0);
            }

            DrawMenu();
        } else {
            // --- 3. MOD LOGIC ---
            if (mod_rapidfire && get_val(FIRE_BTN)) combo_run(cRapidFire);
            if (mod_aimassist && get_val(ADS_BTN))  combo_run(cAimAssist);
            if (mod_dropshot  && get_val(FIRE_BTN)) combo_run(cDropShot);
            if (mod_antirecoil && get_val(FIRE_BTN)) set_val(10, get_val(10) + 25);
        }
    }
}

function DrawMenu() {
    cls_oled(0);
    rect_oled(0, 0, 127, 15, 1, 1); // Header bar
    puts_oled(35, 3, 0, 15, 0);     // "MOD MENU" (Index 15)

    // Side Arrows
    puts_oled(5, 30, 1, 65, 1);     // < (Index 65)
    puts_oled(115, 30, 1, 67, 1);   // > (Index 67)

    // Mod Names
    if (menu_index == 0) puts_oled(25, 30, 1, 24, 1); // RAPID FIRE
    if (menu_index == 1) puts_oled(20, 30, 1, 35, 1); // ANTI-RECOIL
    if (menu_index == 2) puts_oled(25, 30, 1, 47, 1); // AIM ASSIST
    if (menu_index == 3) puts_oled(25, 30, 1, 58, 1); // DROP SHOT

    // ON/OFF Status
    int status;
    if (menu_index == 0) status = mod_rapidfire;
    if (menu_index == 1) status = mod_antirecoil;
    if (menu_index == 2) status = mod_aimassist;
    if (menu_index == 3) status = mod_dropshot;

    if (status) puts_oled(55, 50, 1, 69, 1); // ON
    else        puts_oled(50, 50, 1, 72, 1); // OFF
}

combo cRapidFire {
    set_val(FIRE_BTN, 100);
    wait(40);
    set_val(FIRE_BTN, 0);
    wait(30);
}

combo cAimAssist {
    set_val(9, 20); 
    wait(20);
    set_val(9, -20);
    wait(20);
}

combo cDropShot {
    set_val(CROUCH, 100);
    wait(400);
}

// --- FIXED DATA SEGMENT ---
// This uses the data(...) syntax required by the 32-bit compiler
data(
    /* 0  */ 75, 105, 109, 98, 111, 115, 32, 75, 105, 108, 108, 106, 111, 121, 0, // Kimbos Killjoy
    /* 15 */ 77, 79, 68, 32, 77, 69, 78, 85, 0,                                   // MOD MENU
    /* 24 */ 82, 65, 80, 73, 68, 32, 70, 73, 82, 69, 0,                           // RAPID FIRE
    /* 35 */ 65, 78, 84, 73, 45, 82, 69, 67, 79, 73, 76, 0,                       // ANTI-RECOIL
    /* 47 */ 65, 73, 77, 32, 65, 83, 83, 73, 83, 84, 0,                           // AIM ASSIST
    /* 58 */ 68, 82, 79, 80, 32, 83, 72, 79, 84, 0,                               // DROP SHOT
    /* 65 */ 60, 0,                                                               // <
    /* 67 */ 62, 0,                                                               // >
    /* 69 */ 79, 78, 0,                                                           // ON
    /* 72 */ 79, 70, 70, 0                                                        // OFF
);
